{
    "compilerOptions": {
        "baseUrl": "./src",
        "target": "ES6",
        "module": "ESNext",
        "lib": ["ES6", "DOM", "DOM.Iterable"],
        "paths": {
            "@/*": ["*"]
        },
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx"
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}
