# CIP API configuration – same key names as sdlc-api. Copy to .env and fill in the values.
environment="development"

# ---- LLM provider used when the UI has not saved one: azure_openai | openai | anthropic | gemini | none ----
llm_provider="azure_openai"

# ---- Azure OpenAI (a deployment name means Azure; leave it empty to call OpenAI directly) ----
openai_base_url=""
openai_api_key=""
openai_deployment_name=""
openai_model=""
openai_api_version="2025-04-01-preview"
openai_temperature=0.3
openai_max_tokens=16000

# ---- Anthropic Claude (anthropic_base_url only for an Azure-hosted / proxied endpoint) ----
anthropic_base_url=""
anthropic_api_key=""
anthropic_deployment_name="claude-opus-4-6"
anthropic_model="claude-opus-4-6"
anthropic_temperature=0.1
anthropic_max_tokens=64000
anthropic_context_length=200000

# ---- Google Gemini ----
google_api_key=""
gemini_model="gemini-2.5-flash-lite"
gemini_embedding_model="gemini-embedding-001"

# ---- MongoDB (memory:// keeps runs in memory, no MongoDB server needed) ----
mongo_db_url="mongodb://localhost:27017"
mongo_db_name="cip"

# ---- Private GitHub repos (never written to clones, reports or logs) ----
github_token=""

# ---- Optional scanners (skipped while empty) ----
snyk_token=""                 # Snyk Open Source – free account: snyk.io → Account settings → Auth token
sonar_host_url=""             # e.g. http://localhost:9000 (docker run -d --name sonarqube -p 9000:9000 sonarqube:community)
sonar_token=""                # SonarQube → My Account → Security → Generate (User token)
# github_token above also enables GitHub Dependabot / code-scanning / secret-scanning alerts for GitHub repos

# ---- MCP servers (without them the scan / docker tools run in-process) ----
scanner_mcp_url="http://127.0.0.1:8051/sse"
docker_mcp_url="http://127.0.0.1:8052/sse"

# ---- Quality gates ----
gate_critical=0
gate_high=0
gate_secrets=0
gate_pass_rate=100
gate_coverage=60
gate_image_critical=0
gate_image_high=5
gate_functional_pass_rate=100
gate_ui_pass_rate=80

# ---- UI browser tests (guided flow, Selenium + headless Chrome) ----
# Leave empty: Selenium Manager finds Chrome and downloads the matching chromedriver.
# Set them only on a machine without internet access or with Chrome in a non-standard folder.
chrome_binary=""
chromedriver_path=""

# ---- Settings page: key that encrypts the saved cloud credentials / env variables (Fernet key) ----
# Leave empty: a key is generated once into cip-api/.settings.key (git-ignored). Keep that file safe.
settings_secret_key=""

# ---- MCP servers: the API starts the scanner / docker MCP servers itself (false = they run elsewhere) ----
start_mcp_servers=true
